# Copy to .env.local and fill in. Leaving the two NEXT_PUBLIC_SUPABASE_* values empty runs the
# app in demo mode (data kept in the browser, colour-heuristic "model").

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI ML service (ml-service/). Locally: http://localhost:7860
ML_API_URL=http://localhost:7860
# Must equal ML_API_KEY in ml-service/.env
ML_API_KEY=

# Used for links in emails/redirects. Your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
