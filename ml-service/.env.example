# Shared secret: must equal ML_API_KEY in web/.env.local. Generate a long random string.
ML_API_KEY=
# Your Vercel URL (comma-separate several). Only used for CORS; the browser never calls this service.
ALLOWED_ORIGIN=http://localhost:3000
# Optional: only download images from this host, e.g. abcd1234.supabase.co
ALLOWED_IMAGE_HOST=
# Defaults to dinov2-small-plantvillage-int8. Use mobilenet-v2-plantvillage after `download_model.py --mobilenet`.
MODEL_VERSION=dinov2-small-plantvillage-int8
